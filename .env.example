# Zapier Catch Hook that receives "Book a demo" form leads (see
# src/app/api/demo-form/route.ts). Get this from the client's Zapier zap:
# trigger "Webhooks by Zapier → Catch Hook". Server-side only — never expose
# it to the browser. Set it in .env.local for dev and in Vercel project
# settings for production.
ZAPIER_WEBHOOK_URL=

# Public origin of THIS deployment (scheme + host, no trailing slash), e.g.
# https://www.mycroft.io. The single source of truth for the site's own URL:
# canonicals, sitemap, robots.txt, JSON-LD, and in-page links back to the main
# site all read it (via src/lib/site-url.ts). Set it per environment so those
# point at the right host — production, staging, and Vercel branch previews.
# Leave blank locally; it defaults to https://www.mycroft.io.
# NOTE: only the main marketing site. Mycroft's subdomains (app./trust./status./
# h./try.) are separate apps with fixed URLs and are NOT derived from this.
NEXT_PUBLIC_SITE_URL=